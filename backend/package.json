{
  "name": "automation_cskh-backend",
  "version": "1.0.0",
  "description": "Backend for automation_cskh",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "lint": "eslint . --ext .ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/jest/bin/jest.js",
    "test:coverage": "node ./node_modules/jest/bin/jest.js --coverage",
    "test:zalo": "node ./node_modules/jest/bin/jest.js tests/__tests__/zalo-pool-fixes.test.ts tests/__tests__/zalo-service-fixes.test.ts --no-coverage",
    "verify:zalo": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/verify-zalo-sync.ts",
    "postinstall": "node ./node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@^3.5.0",
    "@line/bot-sdk": "^11.3.0",
    "@prisma/client": "^5.0.0",
    "@types/socket.io": "^3.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "image-size": "^2.0.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.3",
    "zca-js": "^2.2.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.5.9",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "prisma": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "prisma": {
    "seed": "node ./node_modules/ts-node-dev/lib/bin.js --transpile-only prisma/seed.ts"
  }
}
