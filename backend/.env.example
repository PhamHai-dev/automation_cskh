PORT=3000
NODE_ENV=development

# Cấu hình Cơ sở dữ liệu (Database) - MySQL
DATABASE_URL="mysql://root:root@localhost:3306/automation_cskh"

# Cấu hình Cache/Message Queue - Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_SECRET=super-secret-key-change-it-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Zalo Session Encryption (optional — falls back to JWT_SECRET)
ZALO_SESSION_SECRET=

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# Google Service Account (Dùng để đồng bộ Google Sheet khóa riêng tư / Restricted)
# Cách 1: Trỏ đường dẫn tới file JSON tải từ Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# Cách 2: Hoặc điền trực tiếp client_email và private_key (hoặc dán JSON trực tiếp trên giao diện Admin Web)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

